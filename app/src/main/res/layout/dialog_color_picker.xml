<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Color Source Selection -->
    <RadioGroup
        android:id="@+id/color_source_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/color_source_system"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/color_source_system"
            android:checked="true" />

        <RadioButton
            android:id="@+id/color_source_custom"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/color_source_custom" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/custom_color_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hue -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hue"
            android:textAppearance="?attr/textAppearanceCaption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/text_hue_background"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/gradient_hue" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/text_hue_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="360"
                    android:stepSize="1"
                    app:tickVisible="false"
                    app:trackColorActive="@android:color/transparent"
                    app:trackColorInactive="@android:color/transparent"
                    app:thumbColor="@android:color/white"
                    app:haloColor="@android:color/transparent" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_hue_value_label"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="0" />
        </LinearLayout>

        <!-- Saturation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/saturation"
            android:textAppearance="?attr/textAppearanceCaption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/text_saturation_background"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/gradient_value" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/text_saturation_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:stepSize="1"
                    app:tickVisible="false"
                    app:trackColorActive="@android:color/transparent"
                    app:trackColorInactive="@android:color/transparent"
                    app:thumbColor="@android:color/white"
                    app:haloColor="@android:color/transparent" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_saturation_value_label"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="100" />
        </LinearLayout>

        <!-- Lightness -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/value"
            android:textAppearance="?attr/textAppearanceCaption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/text_value_background"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/gradient_value" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/text_value_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:stepSize="1"
                    app:tickVisible="false"
                    app:trackColorActive="@android:color/transparent"
                    app:trackColorInactive="@android:color/transparent"
                    app:thumbColor="@android:color/white"
                    app:haloColor="@android:color/transparent" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_value_value_label"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="100" />
        </LinearLayout>

        <!-- Alpha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alpha"
            android:textAppearance="?attr/textAppearanceCaption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/text_alpha_checkerboard"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="20dp" />

                <View
                    android:id="@+id/text_alpha_background"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/gradient_alpha" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/text_alpha_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="255"
                    android:stepSize="1"
                    app:tickVisible="false"
                    app:trackColorActive="@android:color/transparent"
                    app:trackColorInactive="@android:color/transparent"
                    app:thumbColor="@android:color/white"
                    app:haloColor="@android:color/transparent" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_alpha_value_label"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="100" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:hint="@string/hex_color_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/text_hex_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:fontFamily="monospace"
                    android:lines="1"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <View
                    android:id="@+id/dialog_preview_checkerboard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:id="@+id/dialog_preview_color"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rounded_outline" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>