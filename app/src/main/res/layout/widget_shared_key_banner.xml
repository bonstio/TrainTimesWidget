<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shared_key_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_shared_key_banner"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:layout_marginBottom="4dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/widget_shared_key_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/widget_shared_key_banner"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/widget_shared_key_dismiss"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:padding="3dp"
        android:src="@drawable/ic_close_small"
        android:contentDescription="@string/clear" />

</LinearLayout>
