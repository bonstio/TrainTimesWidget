<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:fitsSystemWindows="true"
    tools:context=".TrainTimesWidgetConfigureActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/train_24px"
                android:layout_marginEnd="8dp"
                app:tint="?attr/colorControlNormal"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/configuration_title"
                android:textAppearance="?attr/textAppearanceHeadline6" />
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_route" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_layout" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_colors" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_advanced" />
        </com.google.android.material.tabs.TabLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Route Tab Content -->
            <LinearLayout
                android:id="@+id/tab_route_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/route_options"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/from_station_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/from_required">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/from_station"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:padding="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageButton
                        android:id="@+id/swap_stations"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_swap_horiz"
                        android:contentDescription="@string/swap_stations" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/to_station_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/to_required">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/to_station"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:padding="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/display_times_header"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/time_normal_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/shown_from"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_close"
                        app:endIconContentDescription="@string/clear">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/time_normal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageButton
                        android:id="@+id/swap_times"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_swap_horiz"
                        android:contentDescription="@string/swap_stations" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/time_reverse_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/shown_from"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_close"
                        app:endIconContentDescription="@string/clear">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/time_reverse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/display_times_helper"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- Layout Tab Content -->
            <LinearLayout
                android:id="@+id/tab_layout_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_section_header"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_style"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:layout_marginBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/title_style_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <RadioButton
                                android:id="@+id/style_short"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/title_style_short"
                                android:checked="true" />

                            <RadioButton
                                android:id="@+id/style_long"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/title_style_long" />

                            <RadioButton
                                android:id="@+id/style_custom"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/title_style_custom" />
                        </RadioGroup>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/widget_title_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/widget_title_hint"
                            app:helperText="@string/widget_title_helper"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/widget_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapSentences" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_alignment"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:layout_marginBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/alignment_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <RadioButton
                                android:id="@+id/alignment_left"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/alignment_left"
                                android:checked="true" />

                            <RadioButton
                                android:id="@+id/alignment_center"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/alignment_center" />

                            <RadioButton
                                android:id="@+id/alignment_right"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/alignment_right" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Font Size Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/font_size_section_header"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/font_size_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0"
                            android:valueTo="2"
                            android:stepSize="1"
                            android:value="1"
                            app:tickVisible="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/font_size_small"
                                android:gravity="start"
                                android:textAppearance="?attr/textAppearanceCaption" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/font_size_regular"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceCaption" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/font_size_large"
                                android:gravity="end"
                                android:textAppearance="?attr/textAppearanceCaption" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Visibility Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/visibility_section_header"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <CheckBox
                            android:id="@+id/show_icon_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_icon"
                            android:checked="true"
                            android:layout_marginBottom="8dp" />

                        <CheckBox
                            android:id="@+id/show_stops_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/show_stops"
                            android:checked="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/show_stops_helper"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:layout_marginStart="32dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Colors Tab Content -->
            <LinearLayout
                android:id="@+id/tab_colors_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Color Mode Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="16dp">

                    <!-- Text Color Mode -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/color_mode_text_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="?attr/colorPrimary"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_color"
                                android:textAppearance="?attr/textAppearanceCaption"
                                android:layout_marginBottom="8dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                app:cardCornerRadius="4dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#FF808080">

                                <View
                                    android:id="@+id/color_mode_text_preview_checkerboard"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />

                                <View
                                    android:id="@+id/color_mode_text_preview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Background Color Mode -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/color_mode_background_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="0dp"
                        app:strokeColor="?attr/colorPrimary"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/background_color"
                                android:textAppearance="?attr/textAppearanceCaption"
                                android:layout_marginBottom="8dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                app:cardCornerRadius="4dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#FF808080">

                                <View
                                    android:id="@+id/color_mode_background_preview_checkerboard"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />

                                <View
                                    android:id="@+id/color_mode_background_preview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Color Source Selection -->
                <RadioGroup
                    android:id="@+id/color_source_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <RadioButton
                        android:id="@+id/color_source_system"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/color_source_system"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/color_source_custom"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/color_source_custom" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/custom_color_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Hue -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hue"
                        android:textAppearance="?attr/textAppearanceCaption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <View
                                android:id="@+id/text_hue_background"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:layout_marginHorizontal="20dp"
                                android:background="@drawable/gradient_hue" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/text_hue_slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="0"
                                android:valueTo="360"
                                android:stepSize="1"
                                app:tickVisible="false"
                                app:trackColorActive="@android:color/transparent"
                                app:trackColorInactive="@android:color/transparent"
                                app:thumbColor="@android:color/white"
                                app:haloColor="@android:color/transparent" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/text_hue_value_label"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            tools:text="0" />
                    </LinearLayout>

                    <!-- Saturation -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/saturation"
                        android:textAppearance="?attr/textAppearanceCaption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <View
                                android:id="@+id/text_saturation_background"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:layout_marginHorizontal="20dp"
                                android:background="@drawable/gradient_value" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/text_saturation_slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="0"
                                android:valueTo="100"
                                android:stepSize="1"
                                app:tickVisible="false"
                                app:trackColorActive="@android:color/transparent"
                                app:trackColorInactive="@android:color/transparent"
                                app:thumbColor="@android:color/white"
                                app:haloColor="@android:color/transparent" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/text_saturation_value_label"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            tools:text="100" />
                    </LinearLayout>

                    <!-- Lightness -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value"
                        android:textAppearance="?attr/textAppearanceCaption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <View
                                android:id="@+id/text_value_background"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:layout_marginHorizontal="20dp"
                                android:background="@drawable/gradient_value" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/text_value_slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="0"
                                android:valueTo="100"
                                android:stepSize="1"
                                app:tickVisible="false"
                                app:trackColorActive="@android:color/transparent"
                                app:trackColorInactive="@android:color/transparent"
                                app:thumbColor="@android:color/white"
                                app:haloColor="@android:color/transparent" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/text_value_value_label"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            tools:text="100" />
                    </LinearLayout>

                    <!-- Alpha -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alpha"
                        android:textAppearance="?attr/textAppearanceCaption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <View
                                android:id="@+id/text_alpha_checkerboard"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:layout_marginHorizontal="20dp" />

                            <View
                                android:id="@+id/text_alpha_background"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:layout_marginHorizontal="20dp"
                                android:background="@drawable/gradient_alpha" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/text_alpha_slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="0"
                                android:valueTo="255"
                                android:stepSize="1"
                                app:tickVisible="false"
                                app:trackColorActive="@android:color/transparent"
                                app:trackColorInactive="@android:color/transparent"
                                app:thumbColor="@android:color/white"
                                app:haloColor="@android:color/transparent" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/text_alpha_value_label"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            tools:text="100" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/hex_color_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/text_hex_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textNoSuggestions"
                            android:fontFamily="monospace"
                            android:lines="1"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Advanced Tab Content -->
            <LinearLayout
                android:id="@+id/tab_advanced_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/time_offset_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/offset_minutes">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/time_offset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberSigned" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/departure_count_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/departure_count"
                    app:helperText="@string/departure_count_helper">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/departure_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_widget" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>